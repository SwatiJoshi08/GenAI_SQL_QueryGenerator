GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_selected_groq_model
DATABASE_TYPE=mysql
DATABASE_URL=your_database_url
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173

# MySQL credentials
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_READER_PASSWORD=your_mysql_reader_password
MYSQL_WRITER_PASSWORD=your_mysql_writer_password

# PostgreSQL credentials
POSTGRES_ROOT_PASSWORD=your_postgres_root_password
POSTGRES_READER_PASSWORD=your_postgres_reader_password
POSTGRES_WRITER_PASSWORD=your_postgres_writer_password
POSTGRES_READER_HISTORY_PASSWORD=your_postgres_reader_history_password
POSTGRES_WRITER_HISTORY_PASSWORD=your_postgres_writer_history_password
